# Copy to .env.local and fill in. Read only by server code (src/lib/openai.ts).
# Never prefix it with NEXT_PUBLIC_: that would inline it into the browser bundle.
OPENAI_API_KEY=

# Optional: other models, if the key can't use the defaults.
# OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
# OPENAI_SUGGEST_MODEL=gpt-6-luna
